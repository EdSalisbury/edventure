mads 2.1.3
Source: edventure.s
     1 				; EdVenture
     2 				; An exploration into Atari 8-Bit Programming
     3 				; Ed Salisbury
     4 				; 2021-07-30
     5
     6 				    org $5000
     7
     8 = 0020			IOCB2=$20   ; I/O Control Block
     9 = 0342			ICCOM=$342  ; Action command
    10 = 0344			ICBAL=$344  ; Buffer address (low byte)
    11 = 0345			ICBAH=$345  ; Buffer address (high byte)
    12 = 034A			ICAX1=$34a  ; Auxilliary information
    13 = 034B			ICAX2=$34b  ; Auxilliary information
    14
    15 = E456			CIOV=$e456  ; CIO Vector
    16 				 
    17 = 009B			eol=$9b
    18 = 0003			openCmd=$03
    19 = 0008			output=$08
    20 FFFF> 5000-5020> 25 1A + buffAddr dta "E:", eol
    21
    22 5003			openScreen
    23 				    ; Set the command to open
    24 5003 A2 20		    ldx #IOCB2
    25 5005 A9 03		    lda #openCmd
    26 5007 9D 42 03		    sta ICCOM, x     ; Put $03 into $362
    27
    28 				    ; Set buffer address (ICBA) to the address of our screen
    29 500A A5 00		    lda buffAddr & 255
    30 500C 9D 44 03		    sta ICBAL, x
    31 500F A5 50		    lda buffAddr / 256
    32 5011 9D 45 03		    sta ICBAH, x
    33
    34 				    ; Set direction to output
    35 5014 A9 08		    lda #output
    36 5016 9D 4A 03		    sta ICAX1, x
    37 5019 A9 00		    lda #0
    38 501B 9D 4B 03		    sta ICAX2, x
    39
    40 				    ; Jump to CIO vector to open the channel
    41 501E 20 56 E4		    jsr CIOV
    42 				   
    43 				    
